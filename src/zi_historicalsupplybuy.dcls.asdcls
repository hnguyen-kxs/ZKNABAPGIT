@EndUserText.label: 'DCL for ZI_HistoricalSupplyBuy'
@MappingRole: true
define role ZI_HISTORICALSUPPLYBUY {
    grant
        select
            on
                ZI_HistoricalSupplyBuy
                    where
                                ( PurchaseOrderType ) =   aspect pfcg_auth (  M_BEST_BSA,
                                                                      BSART,
                                                                      actvt = '03' )
    and                    
         ( Plant ) ?=    aspect pfcg_auth (  M_BEST_WRK, WERKS, actvt = '03' );
                        
}