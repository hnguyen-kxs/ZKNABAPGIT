@EndUserText.label: 'DCL for ZC_KX_HistoricalDemand'
@MappingRole: true
define role ZC_KX_HISTORICALDEMAND {
    grant
        select
            on
                ZC_KX_HistoricalDemand
                    where
                       inheriting conditions from entity ZI_KX_HistoricalDemand;
                        
}