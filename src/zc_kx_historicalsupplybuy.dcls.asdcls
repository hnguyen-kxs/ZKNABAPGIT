@EndUserText.label: 'DCL for ZC_KX_HistoricalSupplyBuy'
@MappingRole: true
define role ZC_KX_HISTORICALSUPPLYBUY {
    grant
        select
            on
                ZC_KX_HistoricalSupplyBuy
                    where
                       inheriting conditions from entity ZI_HistoricalSupplyBuy;
                        
}